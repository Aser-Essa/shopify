<script>
(() => {
  const root = document.getElementById('s26-landing-{{ section.id }}');
  if (!root || root.dataset.s26Ready === 'true') return;
  root.dataset.s26Ready = 'true';

  const variantSelect = root.querySelector('[data-variant-select]');
  const addButton = root.querySelector('[data-add-button]');
  const addLabel = root.querySelector('[data-add-label]');
  const availability = root.querySelector('[data-availability]');
  const priceNodes = root.querySelectorAll('[data-price]');
  const compareNodes = root.querySelectorAll('[data-compare-price]');
  const qty = root.querySelector('input[name="quantity"]');
  const productJsonNode = root.querySelector('[data-product-json]');
  let productData = null;
  try { if (productJsonNode) productData = JSON.parse(productJsonNode.textContent); } catch (e) {}

  const moneyFormat = {{ shop.money_format | json }};
  const formatMoney = (cents) => {
    if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
      return window.Shopify.formatMoney(cents, moneyFormat);
    }
    return (Number(cents || 0) / 100).toLocaleString(undefined, {style:'currency',currency: '{{ cart.currency.iso_code | default: shop.currency }}'});
  };

  const syncVariant = () => {
    if (!variantSelect) return;
    const option = variantSelect.options ? variantSelect.options[variantSelect.selectedIndex] : null;
    if (!option) return;
    const price = Number(option.dataset.price || 0);
    const compare = Number(option.dataset.compare || 0);
    const available = option.dataset.available === 'true';
    priceNodes.forEach(node => { node.textContent = formatMoney(price); });
    compareNodes.forEach(node => {
      if (compare > price) { node.hidden = false; node.textContent = formatMoney(compare); }
      else { node.hidden = true; node.textContent = ''; }
    });
    if (addButton) addButton.disabled = !available;
    if (addLabel) addLabel.textContent = available ? {{ section.settings.add_to_cart | json }} : {{ section.settings.soldout_label | json }};
    if (availability) availability.textContent = available ? {{ section.settings.available_label | json }} : {{ section.settings.soldout_label | json }};

    const imageUrl = option.dataset.image;
    if (imageUrl) {
      root.querySelectorAll('.s26__hero-image, .s26__purchase-image').forEach(img => { img.src = imageUrl; });
    }
    if (productData && option.value) {
      const url = new URL(window.location.href);
      url.searchParams.set('variant', option.value);
      window.history.replaceState({}, '', url.toString());
    }
  };

  if (variantSelect && variantSelect.tagName === 'SELECT') variantSelect.addEventListener('change', syncVariant);
  const minus = root.querySelector('[data-qty-minus]');
  const plus = root.querySelector('[data-qty-plus]');
  if (minus && qty) minus.addEventListener('click', () => { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) - 1); });
  if (plus && qty) plus.addEventListener('click', () => { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + 1); });
  if (qty) qty.addEventListener('change', () => { qty.value = Math.max(1, parseInt(qty.value, 10) || 1); });
  if (variantSelect) syncVariant();
})();
</script>

